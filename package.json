{
  "name": "nyana-ui-workspace",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "dev": "npm run dev --workspace nyana-ui-site",
    "build": "npm run build:lib && npm run build --workspace nyana-ui-site",
    "build:lib": "npm run build --workspace @chengzhimeow/nyana-ui",
    "preview": "npm run preview --workspace nyana-ui-site",
    "typecheck": "npm run typecheck --workspace @chengzhimeow/nyana-ui && npm run typecheck --workspace nyana-ui-site",
    "test": "npm run test --workspace @chengzhimeow/nyana-ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:lib && changeset publish",
    "build:site": "npm run build --workspace nyana-ui-site"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
