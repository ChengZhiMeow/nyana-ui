{
  "name": "@chengzhimeow/nyana-ui",
  "private": false,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChengZhiMeow/nyana-ui.git",
    "directory": "packages/nyana-ui"
  },
  "homepage": "https://github.com/ChengZhiMeow/nyana-ui#readme",
  "bugs": {
    "url": "https://github.com/ChengZhiMeow/nyana-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./src/styles/index.scss",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "sass": "^1.104.1",
    "typescript": "~5.9",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
